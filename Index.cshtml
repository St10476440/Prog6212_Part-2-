@{ ViewData["Title"] = "Home"; }
<section class="hero" aria-labelledby="welcome-title">
    <p class="eyebrow">YOUR NEXT STARTING LINE</p>
    <h1 id="welcome-title">Make every<br />kilometre count.</h1>
    <p>One place to discover race events, manage entries and celebrate your results.</p>
    <a class="button" href="#experience">Explore RaceDay</a>
</section>
<section id="experience" aria-labelledby="experience-title">
    <h2 id="experience-title">Built for both sides of race day</h2>
    <div class="grid">
        <article class="card"><p class="eyebrow">PARTICIPANTS</p><h3>Find your next challenge</h3><p>Event browsing, entries and personal results will be available here as the platform is developed.</p></article>
        <article class="card"><p class="eyebrow">ORGANISERS</p><h3>Bring your event to life</h3><p>Event management, participant lists and results publishing will be added in the next stages.</p></article>
    </div>
</section>
