@model RaceDay.Web.Models.RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<section class="auth-panel">
    <p class="eyebrow">JOIN THE COMMUNITY</p>
    <h1>Create your account</h1>
    <p class="muted">Choose how you will use RaceDay. You can register as an organiser or participant.</p>
    <form asp-action="Register" method="post" class="form-card">
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
        <label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName" class="validation"></span>
        <label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email" class="validation"></span>
        <label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" autocomplete="tel" /><span asp-validation-for="PhoneNumber" class="validation"></span>
        <label asp-for="Role"></label>
        <select asp-for="Role"><option value="Participant">Participant</option><option value="Organiser">Organiser</option></select>
        <span asp-validation-for="Role" class="validation"></span>
        <label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password" class="validation"></span>
        <label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="validation"></span>
        <button class="button" type="submit">Create account</button>
    </form>
    <p class="form-foot">Already registered? <a asp-action="Login">Sign in</a></p>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
