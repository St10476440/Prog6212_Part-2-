@{ ViewData["Title"] = "Participant dashboard"; }
<section class="dashboard-heading">
    <p class="eyebrow">PARTICIPANT SPACE</p>
    <h1>Welcome, @Context.Session.GetString("FullName")</h1>
    <p class="muted">Your next challenge starts here.</p>
</section>
<div class="grid">
    <article class="card"><p class="eyebrow">DISCOVER</p><h2>Upcoming events</h2><p>Browse races, compare categories and find your next starting line.</p><span class="status-pill pending">API integration next</span></article>
    <article class="card"><p class="eyebrow">YOUR ENTRIES</p><h2>My events</h2><p>Keep track of the events you have entered and their enrolment status.</p><span class="status-pill pending">API integration next</span></article>
    <article class="card"><p class="eyebrow">YOUR PROGRESS</p><h2>My results</h2><p>Review finish times and positions from completed events.</p><span class="status-pill pending">API integration next</span></article>
    <article class="card"><p class="eyebrow">ACCOUNT</p><h2>Profile</h2><p>Manage your personal information and profile picture.</p><span class="status-pill pending">API integration next</span></article>
</div>
