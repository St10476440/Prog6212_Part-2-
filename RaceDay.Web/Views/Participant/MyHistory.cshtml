@model List<RaceDay.Web.Models.ParticipantResultViewModel>
@{ ViewData["Title"] = "My results"; }
<section class="form-page">
    <a class="text-link" asp-action="Index">← Back to participant dashboard</a>
    <p class="eyebrow">YOUR RACE JOURNEY</p>
    <h1>My results history</h1>
    <p class="muted">Your published finish times and race positions.</p>
    @if (ViewBag.Error is string error) { <div class="alert error" role="alert">@error</div> }
    @if (Model.Count == 0)
    {
        <div class="empty-state"><h3>No results yet.</h3><p>Once an organiser publishes your race result, it will appear here.</p></div>
    }
    else
    {
        <div class="entry-list">
        @foreach (var result in Model)
        {
            <article class="entry-row">
                <div><strong>Position @result.Position</strong><span>Finish time: @result.FinishTime.ToString("HH:mm:ss")</span></div>
                <span class="status-pill pending">@result.Status</span>
            </article>
        }
        </div>
    }
</section>
