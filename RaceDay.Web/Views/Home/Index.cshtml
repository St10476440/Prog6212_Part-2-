@{ ViewData["Title"] = "Home"; }
<section class="hero" aria-labelledby="welcome-title">
    <div class="hero-copy">
        <p class="eyebrow">FIND YOUR STARTING LINE</p>
        <h1 id="welcome-title">Every race has<br /><em>a story.</em></h1>
        <p class="hero-lead">Discover events, take your place on the start line and keep every finish in one place.</p>
        <div class="hero-actions">
            <a class="button" asp-controller="Account" asp-action="Register">Create your account</a>
            <a class="text-link" asp-controller="Account" asp-action="Login">Already a member? Sign in →</a>
        </div>
    </div>
    <div class="hero-stats" aria-label="RaceDay platform highlights">
        <div><strong>01</strong><span>Discover events</span></div>
        <div><strong>02</strong><span>Manage entries</span></div>
        <div><strong>03</strong><span>Track results</span></div>
    </div>
</section>
<section class="intro-section">
    <p class="eyebrow">ONE PLATFORM · TWO EXPERIENCES</p>
    <h2>Made for everyone<br />who makes race day.</h2>
    <div class="grid">
        <article class="card"><p class="eyebrow">FOR PARTICIPANTS</p><h3>Your next challenge awaits.</h3><p>Explore upcoming events, choose your category, manage your entries and follow your race history.</p><a class="text-link" asp-controller="Account" asp-action="Register">Join as a participant →</a></article>
        <article class="card"><p class="eyebrow">FOR ORGANISERS</p><h3>Bring your event together.</h3><p>Build event listings, manage categories and participants, and publish race results.</p><a class="text-link" asp-controller="Account" asp-action="Register">Join as an organiser →</a></article>
    </div>
</section>
